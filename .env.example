# XiheAgent (羲和) 环境变量配置模板
# ======================================
# 复制此文件为 .env 并按需修改：
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)

# 项目根目录（未设置时自动检测）
# XIHE_PROJECT_ROOT=/path/to/xihe/project

# 数据目录
XIHE_DATA_DIR=./data

# Redis 配置 - Checkpoint（Agent 运行状态）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=${YOUR_REDIS_PASSWORD}
REDIS_CHECKPOINT_DB=0

# Redis Stream 配置（SSE 事件总线，可选）
# 设置为 true 启用 Redis Stream 多进程模式，false 使用 asyncio.Queue（默认）
USE_REDIS_STREAM=false
REDIS_STREAM_DB=1

# MySQL 配置 - 业务数据（Thread/Run/Finding 等）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=${YOUR_MYSQL_PASSWORD}
MYSQL_DATABASE=xihe

# PostgreSQL 配置 - LangGraph Store（长期记忆）
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=${YOUR_PG_PASSWORD}
PG_DATABASE=xihe

# 工作区配置
AI_WORKSPACE_ROOT=${YOUR_WORKSPACE_ROOT}

# API 密钥（请勿将真实密钥提交到版本控制！）
DEEPSEEK_API_KEY=${YOUR_DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=https://api.deepseek.com
MAIN_MODEL=deepseek-v4-pro

# SCM 平台 Token（按需配置使用的平台）
GITEE_TOKEN=${YOUR_GITEE_TOKEN}
GITHUB_TOKEN=${YOUR_GITHUB_TOKEN}
GITLAB_TOKEN=${YOUR_GITLAB_TOKEN}
CODEUP_TOKEN=${YOUR_CODEUP_TOKEN}

# Codeup（阿里云云效）额外配置
# CODEUP_ORG_ID=${YOUR_CODEUP_ORG_ID}
# CODEUP_API_DOMAIN=https://devops.aliyuncs.com

# 沙盒配置（可选，仅企业多租户场景需要）
USE_SANDBOX=false
# SANDBOX_HOST=${YOUR_SANDBOX_HOST}
# SANDBOX_PORT=8080

# 日志配置
XIHE_LOG_DIR=./logs
XIHE_LOG_LEVEL=INFO
XIHE_LOG_RETENTION_DAYS=14
XIHE_LOG_WHEN=midnight
XIHE_LOG_INTERVAL=1

# 运行时配置
XIHE_API_TIMEOUT=300
XIHE_MAX_RETRIES=3

# 其他选项
# XIHE_DEBUG=true
