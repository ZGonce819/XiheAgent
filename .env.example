# xihe-agent (羲和) 环境变量配置模板
# ======================================
# 复制此文件为 .env 并按需修改：
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (Linux/macOS)

# 项目根目录（未设置时自动检测）
# XIHE_AGENT_PROJECT_ROOT=/path/to/xihe-agent/project

# 数据目录
XIHE_AGENT_DATA_DIR=./data

# Redis 配置 - Checkpoint（Agent 运行状态）
REDIS_HOST=${YOUR_REDIS_HOST}
REDIS_PORT=${YOUR_REDIS_PORT}
# REDIS_PASSWORD=${YOUR_REDIS_PASSWORD}
REDIS_CHECKPOINT_DB=${YOUR_REDIS_CHECKPOINT_DB}

# Redis Stream 配置（SSE 事件总线，可选）
# 设置为 true 启用 Redis Stream 多进程模式，false 使用 asyncio.Queue（默认）
USE_REDIS_STREAM=false
REDIS_STREAM_DB=${YOUR_REDIS_STREAM_DB}

# MySQL 配置 - 业务数据（Thread/Run/Finding 等）
MYSQL_HOST=${YOUR_MYSQL_HOST}
MYSQL_PORT=${YOUR_MYSQL_PORT}
MYSQL_USER=${YOUR_MYSQL_USER}
MYSQL_PASSWORD=${YOUR_MYSQL_PASSWORD}
MYSQL_DATABASE=${YOUR_MYSQL_DATABASE}

# PostgreSQL 配置 - LangGraph Store（长期记忆）
PG_HOST=${YOUR_PG_HOST}
PG_PORT=${YOUR_PG_PORT}
PG_USER=${YOUR_PG_USER}
PG_PASSWORD=${YOUR_PG_PASSWORD}
PG_DATABASE=${YOUR_PG_DATABASE}

# 工作区配置
AI_WORKSPACE_ROOT=${YOUR_WORKSPACE_ROOT}

# API 密钥（请勿将真实密钥提交到版本控制！）
DEEPSEEK_API_KEY=${YOUR_DEEPSEEK_API_KEY}
DEEPSEEK_BASE_URL=${YOUR_DEEPSEEK_BASE_URL}
MAIN_MODEL=${YOUR_MAIN_MODEL}

# SCM 平台 Token（按需配置使用的平台）
GITEE_TOKEN=${YOUR_GITEE_TOKEN}
GITHUB_TOKEN=${YOUR_GITHUB_TOKEN}
CODEUP_TOKEN=${YOUR_CODEUP_TOKEN}

# Codeup（阿里云云效）额外配置
# CODEUP_ORG_ID=${YOUR_CODEUP_ORG_ID}
# CODEUP_API_DOMAIN=${YOUR_CODEUP_API_DOMAIN}

# 沙盒配置（可选，仅企业多租户场景需要）
USE_SANDBOX=false
# SANDBOX_HOST=${YOUR_SANDBOX_HOST}  # 完整 URL，如 http://127.0.0.1:8080
# SANDBOX_API_KEY=${YOUR_SANDBOX_API_KEY}  # 与 opensandbox-server 配置的 api_key 一致
# SANDBOX_IDLE_TIMEOUT_DAYS=3  # 沙箱空闲超过此天数自动清理
# SANDBOX_MAX_PER_THREAD=3    # 每个线程最多保留的沙箱数量

# 日志配置
XIHE_AGENT_LOG_DIR=./logs
XIHE_AGENT_LOG_LEVEL=INFO
XIHE_AGENT_LOG_RETENTION_DAYS=14
XIHE_AGENT_LOG_WHEN=midnight
XIHE_AGENT_LOG_INTERVAL=1

# 运行时配置
XIHE_AGENT_API_TIMEOUT=300
XIHE_AGENT_MAX_RETRIES=3

# 其他选项
# XIHE_AGENT_DEBUG=true
